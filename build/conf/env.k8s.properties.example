# Environment variables passed to the spark-submit process.
# Copy this file, uncomment and adjust the values for the submission host.
# Keep the copy at mode 0600 when it contains credentials.

# JAVA_HOME=/usr/lib/jvm/java-11
# JDK 17 is also supported: JAVA_HOME=/usr/lib/jvm/java-17
# KUBECONFIG=/home/spark/.kube/config
# SPARK_CONF_DIR=/etc/spark/conf
# HADOOP_CONF_DIR=/etc/hadoop/conf
#
# Do not point SPARK_CONF_DIR or HADOOP_CONF_DIR at a directory containing
# credentials. Spark copies driver configuration into a Kubernetes ConfigMap.
