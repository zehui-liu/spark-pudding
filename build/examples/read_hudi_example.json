{
  "job": {
    "mode": "batch",
    "sparkHome": "${SPARK_HOME}",
    "sparkPuddingHome": "${PUDDING_HOME}",
    "appName": "spark hudi example job",
    "master": "local[*]",
    "deployMode": "client",
    "describe": "read a Hudi table with an incremental query",
    "config": {
      "spark.executor.memory": "1g",
      "spark.executor.cores": "2",
      "spark.driver.memory": "1g",
      "spark.driver.cores": "1",
      "spark.executor.instances": "2"
    }
  },
  "source": [
    {
      "type": "hudi-source",
      "describe": "read a Hudi table with an incremental query",
      "id": "source-1",
      "config": {
        "table": "test_table",
        "tablePath": "hdfs://namenode:port/path/to/hudi/table",
        "queryType": "incremental",
        "beginTime": "20230101000000",
        "endTime": "20230102000000",
        "options": {
          "hoodie.datasource.read.use.newer.timeline": "true"
        }
      }
    }
  ],
  "sink": [
    {
      "type": "console-sink",
      "describe": "show incremental data on console",
      "id": "sink1",
      "config": {
        "isStreaming": false,
        "numRows": 20,
        "truncate": 50,
        "vertical": false,
        "printSchema": true
      },
      "dependency": "source-1"
    }
  ]
}
